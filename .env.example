# ─── EmailJS Configuration (Frontend-Only SDK) ──────────────────────────────
# Obtain these values from https://dashboard.emailjs.com
# 1. Email Services → Service ID (e.g., service_xxxxxxx)
# 2. Email Templates → Template ID (e.g., template_xxxxxxx)
# 3. Account → API Keys → Public Key (e.g., xxxxxxxxxxxxxxxxxxxxxx)

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
